# QuoteMetric System Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./database/quotemetric.db

# JWT Secret (CHANGE THIS in production - use 32+ random characters!)
JWT_SECRET=quotemetric-secret-key-change-in-production-2026

# Session Secret (CHANGE THIS in production)
SESSION_SECRET=quotemetric-session-secret-2026

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# AI Configuration
AI_UPSELL_ENABLED=true

# Company Info
COMPANY_NAME=QuoteMetric
COMPANY_PHONE=(248) 202-7636
COMPANY_EMAIL=support@quotemetric.io
